{
  "name": "cosmo-career-pathways-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Promo video for COSMO Career Pathways, rendered with Remotion from the site's own artwork.",
  "scripts": {
    "studio": "remotion studio src/index.jsx --public-dir=../assets",
    "render": "npm run render:vertical && npm run render:landscape",
    "render:vertical": "remotion render src/index.jsx Vertical out/cosmo-promo-vertical.mp4 --public-dir=../assets --codec=h264 --crf=18",
    "render:landscape": "remotion render src/index.jsx Landscape out/cosmo-promo-landscape.mp4 --public-dir=../assets --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  }
}
